filters:
  and:
    - file.inFolder("Trading212")
views:
  - type: table
    name: Table
    order:
      - file.name
      - Preis
      - Modifikator
      - aliases
      - Beschreibung
      - link
    sort:
      - property: file.name
        direction: ASC
      - property: Modifikator
        direction: DESC
